---
import { profile } from "../data/content";
import { ui } from "../data/ui";
import T from "./T.astro";
import Terminal from "./Terminal.astro";
import NeuralField from "./NeuralField.astro";
---

<section id="home" class="hero section" data-palette="iris">
  <NeuralField />

  <div class="shell hero-grid">
    <div class="hero-copy">
      <!-- Status Badge -->
      <div class="hero-status reveal">
        <span class="status-badge">
          <span class="status-dot"></span>
          <T es="Disponible para Proyectos & Agentes de IA" en="Available for AI & Agentic Systems" />
        </span>
      </div>

      <h1 class="hero-title font-display reveal" data-delay="1" data-decode>
        <T es={profile.headline.es} en={profile.headline.en} />
      </h1>

      <p class="hero-intro section-lead reveal" data-delay="2">
        <T es={profile.intro.es} en={profile.intro.en} />
      </p>

      <div class="hero-actions reveal" data-delay="3">
        <a class="btn btn-primary" href="#projects">
          <T es={ui.cta_projects.es} en={ui.cta_projects.en} />
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href="#anatomy">
          <T es="Ver Arquitectura" en="Explore Architecture" />
        </a>
      </div>

      <!-- Quick Metrics Bento Strip -->
      <div class="hero-metrics-strip reveal" data-delay="3">
        <div class="hero-metric-item">
          <span class="metric">95%</span>
          <span class="metric-desc font-mono"><T es="Tiempos operacionales recortados" en="Operational time cut" /></span>
        </div>
        <div class="hero-metric-item">
          <span class="metric">100%</span>
          <span class="metric-desc font-mono"><T es="Inferencia agéntica local" en="Local agentic inference" /></span>
        </div>
        <div class="hero-metric-item">
          <span class="metric">Top 3</span>
          <span class="metric-desc font-mono"><T es="Talent Land IBM Track 2026" en="Talent Land IBM Track 2026" /></span>
        </div>
      </div>
    </div>

    <!-- Terminal Interactiva -->
    <div class="hero-terminal-container reveal" data-delay="2">
      <Terminal />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: calc(52px + var(--space-12));
    padding-bottom: var(--space-12);
    position: relative;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
  }

  .hero-status {
    margin-bottom: var(--space-4);
  }

  .hero-title {
    font-size: var(--text-hero);
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-top: var(--space-2);
  }

  .hero-intro {
    margin-top: var(--space-4);
    max-width: 54ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .hero-metrics-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .hero-metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .metric-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .hero-terminal-container {
    position: relative;
    width: 100%;
    max-width: 580px;
    margin-inline: auto;
  }

  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-12);
    }
    .hero-terminal-container {
      margin-inline: 0;
      justify-self: end;
    }
  }

  @media (max-width: 640px) {
    .hero-metrics-strip {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>

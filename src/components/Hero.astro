---
import { profile } from "../data/content";
import { ui } from "../data/ui";
import T from "./T.astro";
import Terminal from "./Terminal.astro";
import NeuralField from "./NeuralField.astro";
---

<section id="home" class="hero section" data-palette="iris">
  <NeuralField />

  <div class="shell hero-grid">
    <div class="hero-copy">
      <div class="hero-header-block reveal">
        <p class="kicker">
          <T es={profile.role.es} en={profile.role.en} />
        </p>

        <h1 class="hero-title" data-decode>
          <T es={profile.headline.es} en={profile.headline.en} />
        </h1>
      </div>

      <p class="hero-intro section-lead reveal" data-delay="1">
        <T es={profile.intro.es} en={profile.intro.en} />
      </p>

      <div class="hero-actions reveal" data-delay="2">
        <a class="btn btn-primary" href="#projects">
          <T es={ui.cta_projects.es} en={ui.cta_projects.en} />
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href={`mailto:${profile.email}`}>
          <T es={ui.cta_contact.es} en={ui.cta_contact.en} />
        </a>
      </div>

      <div class="hero-meta reveal font-mono" data-delay="3">
        <span class="meta-item">📍 <T es={profile.location.es} en={profile.location.en} /></span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <a class="meta-item link-underline" href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </div>

    <div class="hero-terminal-container reveal" data-delay="2">
      <Terminal />
    </div>
  </div>

  <div class="scroll-hint font-mono" aria-hidden="true">
    <T es={ui.scroll.es} en={ui.scroll.en} />
    <span class="scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: calc(56px + var(--space-8));
    padding-bottom: var(--space-12);
    position: relative;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 1.04;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-top: var(--space-3);
    color: var(--text-primary);
  }

  .hero-intro {
    margin-top: var(--space-6);
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .meta-sep {
    color: var(--text-dim);
  }

  .hero-terminal-container {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: var(--space-4);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-dim);
    user-select: none;
    z-index: 2;
  }

  .scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(180deg, var(--accent), transparent);
    animation: scroll-bounce 2.2s infinite ease-in-out;
  }

  @keyframes scroll-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.3; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-12);
    }
    .hero-terminal-container {
      margin-inline: 0;
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line { animation: none; opacity: 0.5; }
  }
</style>

---
import { projects } from "../data/content";
import { ui } from "../data/ui";
import T from "./T.astro";
---

<section id="projects" class="section" data-palette="iris">
  <div class="shell">
    <div class="proj-head">
      <p class="kicker reveal"><T es={ui.projects_kicker.es} en={ui.projects_kicker.en} /></p>
      <h2 class="section-title font-display reveal" data-delay="1"><T es={ui.projects_title.es} en={ui.projects_title.en} /></h2>
      <p class="section-lead reveal" data-delay="2"><T es={ui.projects_lead.es} en={ui.projects_lead.en} /></p>
    </div>

    <div class="proj-list">
      {projects.map((p, i) => (
        <article class="proj card reveal" data-palette={p.palette} data-delay={(i % 2) + 1} id={`proj-${p.id}`}>
          <!-- Cabecera de Proyecto -->
          <div class="proj-top">
            <div>
              <span class="proj-meta font-mono"><T es={p.meta.es} en={p.meta.en} /></span>
              <h3 class="proj-name font-display">{p.name}</h3>
              <p class="proj-tagline"><T es={p.tagline.es} en={p.tagline.en} /></p>
            </div>
            <span class="proj-index font-mono" aria-hidden="true">0{i + 1}</span>
          </div>

          <!-- Flujo Interactivo de Grafo LangGraph -->
          {p.id === "argos" && (
            <div class="langgraph-flow reveal" data-delay="2">
              <div class="flow-title font-mono">
                <span class="pulse-dot"></span>
                <span>LANGGRAPH INTERACTIVE PIPELINE (HAZ CLIC EN CADA NODO)</span>
              </div>
              <div class="flow-nodes font-mono" data-interactive-graph="argos">
                <button class="node-btn active" type="button" data-node-info="Clasificación de intención académica con LLM local Ollama.">Classifier</button>
                <span class="arrow" aria-hidden="true">→</span>
                <button class="node-btn" type="button" data-node-info="Descomposición de la consulta en 3 subpreguntas en paralelo.">Decompose</button>
                <span class="arrow" aria-hidden="true">→</span>
                <button class="node-btn" type="button" data-node-info="Búsqueda concurrente en Semantic Scholar API & arXiv.">Search</button>
                <span class="arrow" aria-hidden="true">→</span>
                <button class="node-btn" type="button" data-node-info="Filtro duro de confiabilidad (Metadata completa + Peer-review).">Validate</button>
                <span class="arrow" aria-hidden="true">→</span>
                <button class="node-btn" type="button" data-node-info="Síntesis final de reporte estructurado en Markdown con citas.">Synthesis</button>
              </div>
              <div class="graph-inspector font-mono" id="inspector-argos">
                ℹ️ <span class="inspector-text">Clasificación de intención académica con LLM local Ollama.</span>
              </div>
            </div>
          )}

          {p.id === "aeterna" && (
            <div class="langgraph-flow reveal" data-delay="2">
              <div class="flow-title font-mono">
                <span class="pulse-dot"></span>
                <span>MULTI-MODULE ORCHESTRATOR PATH (HAZ CLIC EN CADA NODO)</span>
              </div>
              <div class="flow-nodes font-mono" data-interactive-graph="aeterna">
                <button class="node-btn active" type="button" data-node-info="Core Orchestrator en Ollama local corriendo en GPU RTX 5060.">Core</button>
                <span class="arrow" aria-hidden="true">→</span>
                <button class="node-btn" type="button" data-node-info="Base vectorial ChromaDB para memoria de contexto de largo plazo.">ChromaDB</button>
                <span class="arrow" aria-hidden="true">→</span>
                <button class="node-btn" type="button" data-node-info="Base de datos relacional SQLite para estado persistente de tareas.">SQLite</button>
                <span class="arrow" aria-hidden="true">→</span>
                <button class="node-btn" type="button" data-node-info="Motor de alertas escalonadas en 4 niveles de severidad.">AlertEngine</button>
                <span class="arrow" aria-hidden="true">→</span>
                <button class="node-btn" type="button" data-node-info="Bot de Telegram para notificaciones y briefing matutino.">Telegram</button>
              </div>
              <div class="graph-inspector font-mono" id="inspector-aeterna">
                ℹ️ <span class="inspector-text">Core Orchestrator en Ollama local corriendo en GPU RTX 5060.</span>
              </div>
            </div>
          )}

          <!-- Paneles Problema vs Solución -->
          <div class="proj-bd">
            <div class="proj-block recessed-panel">
              <span class="proj-label font-mono"><T es={ui.problem_label.es} en={ui.problem_label.en} /></span>
              <p><T es={p.problem.es} en={p.problem.en} /></p>
            </div>
            <div class="proj-block recessed-panel">
              <span class="proj-label font-mono"><T es={ui.solution_label.es} en={ui.solution_label.en} /></span>
              <p><T es={p.solution.es} en={p.solution.en} /></p>
            </div>
          </div>

          <!-- Viñetas de Logros -->
          <ul class="proj-highlights">
            {p.highlights.map((h) => (
              <li><span class="hl-mark" aria-hidden="true">◆</span><T es={h.es} en={h.en} /></li>
            ))}
          </ul>

          <!-- Stack de Tecnologías -->
          <div class="proj-stack">
            <span class="proj-label font-mono"><T es={ui.stack_label.es} en={ui.stack_label.en} /></span>
            <div class="chips">
              {p.stack.map((s) => <span class="chip" data-skill-tag={s}>{s}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const graphs = document.querySelectorAll("[data-interactive-graph]");
    graphs.forEach((graph) => {
      const id = graph.getAttribute("data-interactive-graph");
      const inspector = document.getElementById(`inspector-${id}`);
      const textEl = inspector ? inspector.querySelector(".inspector-text") : null;
      const btns = graph.querySelectorAll(".node-btn");

      btns.forEach((btn) => {
        btn.addEventListener("click", () => {
          btns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          const info = btn.getAttribute("data-node-info");
          if (textEl && info) {
            textEl.textContent = info;
          }
        });
      });
    });
  })();
</script>

<style>
  .proj-head { max-width: 62ch; margin-bottom: var(--space-12); }
  .proj-list { display: grid; gap: var(--space-12); }
  .proj { padding: clamp(1.6rem, 1.2rem + 2vw, 3rem); }

  .proj-top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4); }
  .proj-meta { font-size: var(--text-xs); letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-2); }
  .proj-name { font-size: var(--text-2xl); font-weight: 700; margin-top: var(--space-2); }
  .proj-tagline { margin-top: var(--space-2); color: var(--text-secondary); max-width: 48ch; font-size: var(--text-base); }
  .proj-index { font-size: var(--text-2xl); color: rgba(var(--glow), 0.25); line-height: 1; user-select: none; }

  .langgraph-flow {
    margin-block: var(--space-6) var(--space-4);
    padding: var(--space-4);
    background: var(--bg-surface-recessed);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .flow-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.62rem;
    color: var(--text-muted);
    letter-spacing: 0.16em;
    margin-bottom: var(--space-3);
  }

  .pulse-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .flow-nodes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    font-size: var(--text-xs);
  }

  .node-btn {
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-sm);
    background: var(--bg-surface-base);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: all var(--dur-fast) ease;
  }

  .node-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
  }

  .node-btn.active {
    background: var(--accent);
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 0 12px rgba(var(--glow), 0.5);
  }

  .arrow { color: var(--text-dim); }

  .graph-inspector {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--border-subtle);
    font-size: var(--text-xs);
    color: var(--accent-2);
  }

  .proj-bd { display: grid; grid-template-columns: 1fr; gap: var(--space-4); margin-top: var(--space-6); }
  .proj-label { display: block; font-size: var(--text-xs); letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-2); }
  .proj-block p { color: var(--text-secondary); font-size: var(--text-base); }

  .proj-highlights {
    list-style: none;
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }
  .proj-highlights li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    color: var(--text-secondary);
    font-size: var(--text-base);
  }
  .hl-mark { color: var(--accent); font-size: 0.7rem; line-height: 1.7; }

  .proj-stack { margin-top: var(--space-6); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  @media (min-width: 760px) {
    .proj-bd { grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  }
</style>

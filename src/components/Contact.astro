---
import { profile } from "../data/content";
import { ui } from "../data/ui";
import T from "./T.astro";
const year = new Date().getFullYear();
---

<section id="contact" class="section" data-palette="iris">
  <div class="shell">
    <div class="contact-card card reveal">
      <p class="kicker"><T es={ui.contact_kicker.es} en={ui.contact_kicker.en} /></p>
      <h2 class="contact-title font-display"><T es={ui.contact_title.es} en={ui.contact_title.en} /></h2>
      <p class="section-lead" style="margin-inline:auto;"><T es={ui.contact_lead.es} en={ui.contact_lead.en} /></p>

      <button id="copy-mail-btn" class="contact-mail font-display" type="button" title="Haz clic para copiar correo">
        {profile.email}
      </button>

      <div class="contact-links">
        <button id="copy-mail-action" class="btn btn-primary" type="button">
          <T es={ui.email_label.es} en={ui.email_label.en} /> <span aria-hidden="true">→</span>
        </button>

        <!-- Botones con logos oficiales y colores de marca -->
        <a class="btn social-btn btn-linkedin" href={profile.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
          <span>LinkedIn</span>
        </a>

        <a class="btn social-btn btn-github" href={profile.links.github} target="_blank" rel="noopener" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/>
          </svg>
          <span>GitHub</span>
        </a>

        <a class="btn social-btn btn-instagram" href={profile.links.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>Instagram</span>
        </a>
      </div>
    </div>
  </div>

  <footer class="footer">
    <div class="shell footer-inner">
      <span class="font-mono">© {year} {profile.name}</span>
      <span class="font-mono footer-credit"><T es={ui.rights.es} en={ui.rights.en} /> · Astro</span>
    </div>
  </footer>
</section>

<script is:inline define:vars={{ userEmail: profile.email }}>
  (function () {
    const btnText = document.getElementById("copy-mail-btn");
    const btnAction = document.getElementById("copy-mail-action");
    const toast = document.getElementById("global-toast");

    function copyEmail() {
      navigator.clipboard.writeText(userEmail).then(() => {
        if (toast) {
          toast.classList.add("is-show");
          setTimeout(() => { toast.classList.remove("is-show"); }, 2800);
        }
      }).catch(() => {
        window.location.href = "mailto:" + userEmail;
      });
    }

    if (btnText) btnText.addEventListener("click", copyEmail);
    if (btnAction) btnAction.addEventListener("click", copyEmail);
  })();
</script>

<style>
  .contact-card { 
    text-align: center; 
    max-width: 860px; 
    margin-inline: auto; 
    padding: clamp(2.5rem, 2rem + 4vw, 5rem) clamp(1.2rem, 1rem + 2.5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .contact-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-top: var(--space-4);
    line-height: 1.08;
    max-width: 20ch;
  }
  
  .contact-mail {
    display: inline-block; 
    margin-top: var(--space-8); 
    font-size: clamp(1.2rem, 0.9rem + 2vw, 2.2rem);
    color: var(--accent-2); 
    background: transparent;
    border: none;
    border-bottom: 1px dashed var(--accent); 
    cursor: pointer;
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .contact-mail:hover {
    color: var(--text-primary);
    border-color: #ffffff;
  }
  
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
    margin-top: var(--space-8);
  }

  /* Botones de Redes Sociales con Colores Oficiales de Marca */
  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    transition: transform var(--dur-fast) var(--ease-spring), filter var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
  }

  .social-btn:hover {
    transform: translateY(-2px) scale(1.02);
    filter: brightness(1.1);
  }

  .btn-linkedin {
    background: #0a66c2 !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    box-shadow: 0 4px 16px rgba(10, 102, 194, 0.4) !important;
  }

  .btn-github {
    background: #181717 !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6) !important;
  }

  .btn-instagram {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    box-shadow: 0 4px 16px rgba(220, 39, 67, 0.45) !important;
  }

  .footer {
    margin-top: clamp(4rem, 3rem + 6vw, 7rem);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-6);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--text-dim);
  }
</style>

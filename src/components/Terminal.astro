---
import T from "./T.astro";
---

<div class="terminal card" id="hero-terminal">
  <!-- Cabecera de la Ventana -->
  <div class="terminal-header">
    <div class="window-controls" aria-hidden="true">
      <span class="control close"></span>
      <span class="control minimize"></span>
      <span class="control maximize"></span>
    </div>
    <div class="terminal-title font-mono">diego@escom-terminal:~</div>
    <div class="terminal-actions">
      <button id="terminal-run-btn" class="run-btn" type="button" title="Ejecutar Script / Run Script" aria-label="Ejecutar script en terminal">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span class="font-mono">RUN</span>
      </button>
    </div>
  </div>

  <!-- Pestañas de Archivos -->
  <div class="terminal-tabs" role="tablist" aria-label="Pestañas de la consola">
    <button class="tab-item active" type="button" role="tab" aria-selected="true" aria-controls="content-argos" id="tab-argos" data-tab="argos">
      <span class="tab-icon" aria-hidden="true">🐍</span>
      <span class="font-mono">argos.py</span>
    </button>
    <button class="tab-item" type="button" role="tab" aria-selected="false" aria-controls="content-aeterna" id="tab-aeterna" data-tab="aeterna">
      <span class="tab-icon" aria-hidden="true">🐍</span>
      <span class="font-mono">aeterna.py</span>
    </button>
    <button class="tab-item" type="button" role="tab" aria-selected="false" aria-controls="content-skills" id="tab-skills" data-tab="skills">
      <span class="tab-icon" aria-hidden="true">🐚</span>
      <span class="font-mono">skills.sh</span>
    </button>
  </div>

  <!-- Pantalla de la Consola -->
  <div class="terminal-body recessed-panel">
    <!-- Tab: Argos -->
    <div class="terminal-content active" id="content-argos" role="tabpanel" aria-labelledby="tab-argos">
      <div class="terminal-line command">
        <span class="prompt">$</span><span class="typed-command" data-cmd="python -m argos --query 'autonomous reasoning' --local"></span><span class="cursor">_</span>
      </div>
      <div class="terminal-logs" id="logs-argos"></div>
    </div>

    <!-- Tab: Aeterna -->
    <div class="terminal-content" id="content-aeterna" role="tabpanel" aria-labelledby="tab-aeterna">
      <div class="terminal-line command">
        <span class="prompt">$</span><span class="typed-command" data-cmd="python -m aeterna --vigil --active-learning"></span><span class="cursor">_</span>
      </div>
      <div class="terminal-logs" id="logs-aeterna"></div>
    </div>

    <!-- Tab: Skills -->
    <div class="terminal-content" id="content-skills" role="tabpanel" aria-labelledby="tab-skills">
      <div class="terminal-line command">
        <span class="prompt">$</span><span class="typed-command" data-cmd="./skills.sh --list --level=expert"></span><span class="cursor">_</span>
      </div>
      <div class="terminal-logs" id="logs-skills"></div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const argosLogs = [
      { t: "⚡ [LANGGRAPH] Orquestando grafo de estados...", c: "info" },
      { t: "🔍 [STATE: classifier] -> Intención detectada: Académica / Científica", c: "accent" },
      { t: "🛠️ [STATE: decompose] -> Desglosando consulta en 3 subpreguntas para paralelismo...", c: "dim" },
      { t: "🌐 [STATE: search] -> Consultando Semantic Scholar & arXiv...", c: "info" },
      { t: "📚 [STATE: search] -> Encontrados 12 papers. Descargando abstracts...", c: "dim" },
      { t: "🛡️ [STATE: validation] -> Evaluando fiabilidad. Requisitos: Metadata completa + Peer Reviewed.", c: "warning" },
      { t: "✔️ [STATE: validation] -> 4 papers validados (Score > 0.85). 8 descartados.", c: "success" },
      { t: "💬 [STATE: debate] -> Generando antítesis y contraste de hipótesis con IA local...", c: "accent" },
      { t: "📝 [STATE: synthesis] -> Compilando reporte estructurado en Markdown con citas reales...", c: "info" },
      { t: "🚀 [SUCCESS] Proceso completo local en 4.2s. Reporte guardado en /docs/argos_report.md", c: "success" }
    ];

    const aeternaLogs = [
      { t: "👑 [CUSTODES] J.A.R.V.I.S. Core Activo (Inferencia Local Ollama en RTX 5060)", c: "accent" },
      { t: "💾 [MEMORY] Conectando a Base de Datos de Tareas (SQLite)... 143 items cargados.", c: "info" },
      { t: "🧬 [VECTOR] Inicializando ChromaDB... Memoria de contexto de largo plazo cargada.", c: "info" },
      { t: "🏫 [ACADEMIC] Escaneando ESCOM-IPN horarios & entregas... 0 tareas pendientes hoy.", c: "success" },
      { t: "🖥️ [MONITOR] CPU Temp: 42°C | GPU VRAM: 3.4/8GB | Uptime Operativo: 99.98%", c: "dim" },
      { t: "⚠️ [ALERT] Inactividad detectada en proyecto 'Mi Web' (2 días sin commits).", c: "warning" },
      { t: "📈 [ACTION] Escalando recordatorio a nivel de alerta 1...", c: "warning" },
      { t: "✉️ [TELEGRAM] Notificación enviada a Diego: 'Custodian, tu vigilia te espera.'", c: "success" }
    ];

    const skillsLogs = [
      { t: "⚙️  Listando stack tecnológico verificado de Diego Zendreros...", c: "accent" },
      { t: "--------------------------------------------------------", c: "dim" },
      { t: "💻 LENGUAJES:      Python, C / C++, Java, SQL, TypeScript", c: "info" },
      { t: "🤖 IA & AGENTES:    LangGraph, LangChain, Ollama, watsonx, RAG, NLP, CV", c: "success" },
      { t: "📊 DATOS & AUTO:   ChromaDB, SQLite, Pipelines de datos, Automatizaciones", c: "success" },
      { t: "🐳 INFRA & DEVOPS: Docker, GitHub Actions, Redes, VPN, Servidores Linux", c: "warning" },
      { t: "🔧 HERRAMIENTAS:   Git, Telegram API, Microsoft Graph, Astro 5", c: "info" },
      { t: "--------------------------------------------------------", c: "dim" },
      { t: "🟢 Ready for deployment.", c: "success" }
    ];

    const logData = { argos: argosLogs, aeterna: aeternaLogs, skills: skillsLogs };
    let activeTab = "argos";
    let isRunning = false;
    let timeouts = [];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const runBtn = document.getElementById("terminal-run-btn");
    const tabs = document.querySelectorAll(".tab-item");
    const contents = document.querySelectorAll(".terminal-content");

    function clearPendingTimeouts() {
      timeouts.forEach((t) => clearTimeout(t));
      timeouts = [];
    }

    function resetTerminal() {
      clearPendingTimeouts();
      isRunning = false;
      if (runBtn) runBtn.classList.remove("disabled");

      document.querySelectorAll(".typed-command").forEach((el) => { el.textContent = ""; });
      document.querySelectorAll(".terminal-logs").forEach((el) => { el.innerHTML = ""; });
      document.querySelectorAll(".cursor").forEach((el) => { el.style.display = "inline"; });
    }

    function typeCommand(element, text, callback) {
      if (reduce) {
        element.textContent = text;
        if (callback) callback();
        return;
      }
      let index = 0;
      element.textContent = "";
      function type() {
        if (index < text.length) {
          element.textContent += text[index];
          index++;
          const t = setTimeout(type, 30 + Math.random() * 20);
          timeouts.push(t);
        } else if (callback) {
          callback();
        }
      }
      type();
    }

    function printLogs(logContainer, logs, cursorEl) {
      cursorEl.style.display = "none";
      if (reduce) {
        logs.forEach((log) => {
          const line = document.createElement("div");
          line.className = `terminal-line log-line color-${log.c}`;
          line.textContent = log.t;
          logContainer.appendChild(line);
        });
        isRunning = false;
        if (runBtn) runBtn.classList.remove("disabled");
        return;
      }

      let logIndex = 0;
      function printNextLine() {
        if (logIndex < logs.length) {
          const log = logs[logIndex];
          const line = document.createElement("div");
          line.className = `terminal-line log-line color-${log.c}`;
          line.textContent = log.t;
          logContainer.appendChild(line);

          const body = logContainer.closest(".terminal-body");
          if (body) body.scrollTop = body.scrollHeight;

          logIndex++;
          const t = setTimeout(printNextLine, 100 + Math.random() * 100);
          timeouts.push(t);
        } else {
          isRunning = false;
          if (runBtn) runBtn.classList.remove("disabled");
          const finalPrompt = document.createElement("div");
          finalPrompt.className = "terminal-line command";
          finalPrompt.innerHTML = '<span class="prompt">$</span><span class="cursor pulse-indicator">_</span>';
          logContainer.appendChild(finalPrompt);

          const body = logContainer.closest(".terminal-body");
          if (body) body.scrollTop = body.scrollHeight;
        }
      }
      const t = setTimeout(printNextLine, 200);
      timeouts.push(t);
    }

    function runActiveScript() {
      if (isRunning) return;
      isRunning = true;
      if (runBtn) runBtn.classList.add("disabled");

      const activeContent = document.querySelector(`.terminal-content.active`);
      if (!activeContent) return;
      const typedEl = activeContent.querySelector(".typed-command");
      const cursorEl = activeContent.querySelector(".cursor");
      const logsEl = activeContent.querySelector(".terminal-logs");
      const cmdText = typedEl.getAttribute("data-cmd");

      typedEl.textContent = "";
      logsEl.innerHTML = "";
      cursorEl.style.display = "inline";

      typeCommand(typedEl, cmdText, () => {
        printLogs(logsEl, logData[activeTab], cursorEl);
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", function () {
        if (isRunning) return;
        const targetTab = this.getAttribute("data-tab");
        if (targetTab === activeTab) return;

        tabs.forEach((t) => {
          t.classList.remove("active");
          t.setAttribute("aria-selected", "false");
        });
        contents.forEach((c) => c.classList.remove("active"));

        this.classList.add("active");
        this.setAttribute("aria-selected", "true");
        const activePanel = document.getElementById(`content-${targetTab}`);
        if (activePanel) activePanel.classList.add("active");

        activeTab = targetTab;
        resetTerminal();
        runActiveScript();
      });
    });

    if (runBtn) {
      runBtn.addEventListener("click", function () {
        if (isRunning) return;
        resetTerminal();
        runActiveScript();
      });
    }

    /* Trigger por IntersectionObserver */
    const terminalEl = document.getElementById("hero-terminal");
    if (terminalEl) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            runActiveScript();
            observer.unobserve(terminalEl);
          }
        });
      }, { threshold: 0.15 });
      observer.observe(terminalEl);
    }
  })();
</script>

<style>
  .terminal {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 380px;
    background: var(--bg-surface-base);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    background: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-subtle);
  }

  .window-controls {
    display: flex;
    gap: 6px;
  }
  .control {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .control.close { background: #ff5f56; }
  .control.minimize { background: #ffbd2e; }
  .control.maximize { background: #27c93f; }

  .terminal-title {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.02em;
    user-select: none;
  }

  .run-btn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--bg-obsidian);
    border: 1px solid var(--border-subtle);
    color: var(--accent-2);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: all var(--dur-fast) ease;
  }
  .run-btn:hover:not(.disabled) {
    color: #4ade80;
    border-color: var(--border-medium);
  }
  .run-btn.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .terminal-tabs {
    display: flex;
    background: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-subtle);
    padding-inline: 0.5rem;
    gap: 2px;
  }

  .tab-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-size: var(--text-xs);
    cursor: pointer;
    border-top-left-radius: var(--radius-sm);
    border-top-right-radius: var(--radius-sm);
    transition: color var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  .tab-item:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.03);
  }
  .tab-item.active {
    color: var(--accent-2);
    background: var(--bg-surface-base);
    border-top: 2px solid var(--accent-2);
  }

  .terminal-body {
    flex: 1;
    margin: 0.75rem;
    padding: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.55;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: #06070b !important;
  }

  .terminal-content { display: none; }
  .terminal-content.active { display: block; }

  .terminal-line {
    white-space: pre-wrap;
    word-break: break-all;
    margin-bottom: 0.2rem;
  }
  .prompt {
    color: var(--accent);
    margin-right: 0.5rem;
    font-weight: bold;
  }
  .cursor {
    font-weight: bold;
    color: var(--accent-2);
  }

  .color-info { color: #93c5fd; }
  .color-accent { color: var(--accent-2); }
  .color-success { color: #86efac; }
  .color-warning { color: #fde047; }
  .color-dim { color: var(--text-muted); }

  @media (max-width: 480px) {
    .terminal { height: 350px; }
    .terminal-body { font-size: 0.72rem; margin: 0.5rem; padding: 0.6rem; }
    .tab-item { padding: 0.35rem 0.55rem; }
  }
</style>

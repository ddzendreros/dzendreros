---
import { community } from "../data/content";
import T from "./T.astro";
const base = import.meta.env.BASE_URL;
---

<section id="community" class="section" data-palette="sice">
  <div class="shell comm-grid">
    <div class="comm-copy">
      <p class="kicker reveal"><T es={community.kicker.es} en={community.kicker.en} /></p>
      <h2 class="section-title font-display reveal" data-delay="1"><T es={community.title.es} en={community.title.en} /></h2>
      <p class="comm-org font-mono reveal" data-delay="1">
        {community.org} · <T es={community.date.es} en={community.date.en} />
      </p>
      <p class="section-lead reveal" data-delay="2"><T es={community.description.es} en={community.description.en} /></p>

      <div class="comm-topics-container recessed-panel reveal" data-delay="2">
        <span class="topics-label font-mono"><T es="Temas claves compartidos" en="Key topics shared" /></span>
        <ul class="comm-topics">
          {community.topics.map((t) => (
            <li><span class="hl-mark" aria-hidden="true">▹</span><T es={t.es} en={t.en} /></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="comm-media reveal" data-delay="2">
      <div class="comm-frame card">
        <img src={`${base}images/sice-keyart.png`} alt="SICE México — Masterclass" loading="lazy" width="520" height="520" />
      </div>
      <div class="comm-frame comm-frame--sm card">
        <img src={`${base}images/sice-session.jpg`} alt="Sesión de la masterclass" loading="lazy" width="320" height="240" />
      </div>
    </div>
  </div>
</section>

<style>
  .comm-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-12); align-items: center; }
  .comm-org { color: var(--accent-2); font-size: var(--text-xs); margin-top: var(--space-4); letter-spacing: 0.04em; }
  
  .comm-topics-container {
    margin-top: var(--space-6);
    padding: var(--space-6);
  }
  .topics-label {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }
  .comm-topics { list-style: none; display: grid; gap: var(--space-3); }
  .comm-topics li { display: grid; grid-template-columns: auto 1fr; gap: 0.7rem; color: var(--text-secondary); font-size: var(--text-base); }
  .hl-mark { color: var(--accent); }

  .comm-media { position: relative; justify-self: center; max-width: 460px; width: 100%; }
  
  .comm-frame { 
    border-radius: var(--radius-lg); 
    overflow: hidden; 
    position: relative;
    z-index: 2;
  }
  .comm-frame img { display: block; width: 100%; height: auto; filter: saturate(0.98); }
  
  .comm-frame--sm { 
    position: absolute; 
    right: -12px; 
    bottom: -20px; 
    width: 44%; 
    border: 3px solid var(--bg-obsidian); 
    z-index: 3;
    border-radius: var(--radius-md);
  }

  @media (min-width: 920px) {
    .comm-grid { grid-template-columns: 1.1fr 0.9fr; gap: var(--space-12); }
    .comm-media { justify-self: end; }
  }
</style>

---
import { experience, education, skills } from "../data/content";
import { ui } from "../data/ui";
import T from "./T.astro";
---

<section id="experience" class="section" data-palette="steel">
  <div class="shell">
    <div class="exp-head">
      <p class="kicker reveal"><T es={ui.experience_kicker.es} en={ui.experience_kicker.en} /></p>
      <h2 class="section-title font-display reveal" data-delay="1"><T es={ui.experience_title.es} en={ui.experience_title.en} /></h2>
    </div>

    <div class="exp-grid">
      <!-- Línea de Tiempo de Experiencia -->
      <div class="exp-timeline">
        {experience.map((job, i) => (
          <article class="job reveal" data-delay={i + 1}>
            <div class="job-rail" aria-hidden="true">
              <span class="job-dot"></span>
            </div>
            <div class="job-body">
              <div class="job-top">
                <h3 class="job-role font-display"><T es={job.role.es} en={job.role.en} /></h3>
                <span class="job-period font-mono"><T es={job.period.es} en={job.period.en} /></span>
              </div>
              <p class="job-company">{job.company} · <span class="job-loc"><T es={job.location.es} en={job.location.en} /></span></p>
              <ul class="job-bullets">
                {job.bullets.map((b) => (
                  <li><span class="hl-mark" aria-hidden="true">◆</span><T es={b.es} en={b.en} /></li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>

      <!-- Barra Lateral: Educación & Habilidades -->
      <aside class="exp-side">
        <!-- Educación -->
        <div class="side-block card reveal">
          <span class="proj-label font-mono"><T es={ui.education_label.es} en={ui.education_label.en} /></span>
          <ul class="edu-list">
            {education.map((e) => (
              <li class="edu-item">
                <strong class="font-display"><T es={e.degree.es} en={e.degree.en} /></strong>
                <span class="edu-school">{e.school}</span>
                <span class="edu-period font-mono"><T es={e.period.es} en={e.period.en} /></span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Habilidades Técnicas -->
        <div class="side-block card reveal" data-delay="1">
          <span class="proj-label font-mono"><T es={ui.skills_label.es} en={ui.skills_label.en} /></span>
          <div class="skills">
            {skills.map((g) => (
              <div class="skill-group">
                <span class="skill-name font-mono"><T es={g.group.es} en={g.group.en} /></span>
                <div class="chips">{g.items.map((it) => <span class="chip" data-skill-item={it}>{it}</span>)}</div>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .exp-head { margin-bottom: var(--space-12); }
  .exp-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-12); }

  .exp-timeline { display: grid; gap: var(--space-8); }
  .job { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); }
  
  .job-rail { position: relative; width: 16px; display: flex; justify-content: center; }
  .job-rail::before { 
    content: ""; 
    position: absolute; 
    top: 6px; 
    bottom: -2.4rem; 
    width: 2px; 
    background: var(--border-medium); 
  }
  .job:last-child .job-rail::before { display: none; }
  
  .job-dot { 
    width: 12px; 
    height: 12px; 
    border-radius: 50%; 
    background: var(--accent); 
    box-shadow: 0 0 8px var(--accent);
    margin-top: 6px; 
    z-index: 2;
  }

  .job-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem; justify-content: space-between; }
  .job-role { font-size: var(--text-lg); font-weight: 600; }
  .job-period { font-size: var(--text-xs); color: var(--accent-2); }
  .job-company { color: var(--text-secondary); margin-top: 0.25rem; font-size: var(--text-sm); }
  .job-loc { color: var(--text-muted); }
  .job-bullets { list-style: none; display: grid; gap: var(--space-3); margin-top: var(--space-4); }
  .job-bullets li { display: grid; grid-template-columns: auto 1fr; gap: 0.7rem; color: var(--text-secondary); font-size: var(--text-base); }
  .hl-mark { color: var(--accent); font-size: 0.7rem; line-height: 1.7; }

  .exp-side { display: grid; gap: var(--space-6); align-content: start; }
  .side-block { padding: clamp(1.4rem, 1rem + 1.4vw, 2.2rem); }
  .proj-label { display: block; font-size: var(--text-xs); letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-4); }
  
  .edu-list { list-style: none; display: grid; gap: var(--space-4); }
  .edu-item { 
    display: grid; 
    gap: 0.2rem; 
    padding-bottom: var(--space-4);
    border-bottom: 1px dashed var(--border-subtle);
  }
  .edu-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .edu-list strong { font-weight: 600; font-size: var(--text-base); }
  .edu-school { color: var(--text-secondary); font-size: var(--text-sm); }
  .edu-period { color: var(--text-muted); font-size: var(--text-xs); }

  .skills { display: grid; gap: var(--space-4); }
  .skill-group { display: grid; gap: 0.5rem; }
  .skill-name { font-size: var(--text-xs); color: var(--text-secondary); letter-spacing: 0.04em; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  @media (min-width: 940px) {
    .exp-grid { grid-template-columns: 1.35fr 0.95fr; gap: var(--space-12); }
  }
</style>

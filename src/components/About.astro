---
import { about, profile } from "../data/content";
import { ui } from "../data/ui";
import T from "./T.astro";
const base = import.meta.env.BASE_URL;
---

<section id="about" class="section" data-palette="iris">
  <div class="shell">
    <div class="about-head">
      <p class="kicker reveal"><T es={ui.about_kicker.es} en={ui.about_kicker.en} /></p>
      <h2 class="section-title reveal" data-delay="1">
        <T es={ui.about_title.es} en={ui.about_title.en} />
      </h2>
    </div>

    <!-- Bento Layout de Sobre Mí -->
    <div class="bento-grid about-bento">
      <!-- Bio Narrative (Col 7) -->
      <div class="bento-col-8 card about-narrative-card reveal">
        <div class="about-paragraphs">
          {about.paragraphs.map((p, i) => (
            <p class="about-p">
              <T es={p.es} en={p.en} />
            </p>
          ))}
        </div>
      </div>

      <!-- Portrait & Status (Col 4) -->
      <div class="bento-col-4 card about-portrait-card reveal" data-delay="1">
        <div class="portrait-container">
          <img
            src={`${base}images/diego-portrait.jpg`}
            alt={profile.name}
            width="400"
            height="520"
            loading="lazy"
          />
          <div class="portrait-badge font-mono">
            <span class="status-dot"></span>
            <T es="Hablemos de IA" en="Let's talk AI" />
          </div>
        </div>
      </div>

      <!-- Metrics Bento Strip (Col 12) -->
      <div class="bento-col-12 metrics-bento-strip">
        {about.facts.map((f, i) => (
          <div class="card metric-card reveal" data-delay={(i % 2) + 1}>
            <span class="metric">{f.value}</span>
            <span class="fact-label font-mono"><T es={f.label.es} en={f.label.en} /></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-head { max-width: 62ch; margin-bottom: var(--space-8); }
  .about-bento { gap: var(--space-6); }

  .about-narrative-card {
    padding: clamp(1.6rem, 1.2rem + 2vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .about-paragraphs {
    display: grid;
    gap: var(--space-4);
  }

  .about-p {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .about-portrait-card {
    padding: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .portrait-container {
    position: relative;
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .portrait-container img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    filter: saturate(0.95);
  }

  .portrait-badge {
    position: absolute;
    bottom: var(--space-3);
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(10, 13, 24, 0.88);
    border: 1px solid var(--border-medium);
    backdrop-filter: blur(8px);
    font-size: var(--text-xs);
    color: var(--text-primary);
    white-space: nowrap;
  }

  .metrics-bento-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .metric-card {
    padding: var(--space-6) var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.3rem;
  }

  .fact-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    max-width: 20ch;
  }

  @media (max-width: 900px) {
    .metrics-bento-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .metrics-bento-strip {
      grid-template-columns: 1fr;
    }
  }
</style>

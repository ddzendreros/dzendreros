---
import { nav } from "../data/ui";
import { profile } from "../data/content";
import T from "./T.astro";
const base = import.meta.env.BASE_URL;
---

<header class="nav-dock-container" id="main-nav">
  <div class="nav-dock">
    <a class="brand" href="#home" aria-label={profile.shortName}>
      <img class="brand-logo" src={`${base}images/logo-mark.png`} alt="" width="28" height="29" />
      <span class="brand-name font-display">{profile.shortName}</span>
    </a>

    <div class="nav-divider" aria-hidden="true"></div>

    <nav class="nav-links" aria-label="Navegación principal">
      {nav.map((item) => (
        <a href={`#${item.id}`} class="nav-link font-mono" data-nav-item={item.id}>
          <T es={item.label.es} en={item.label.en} />
        </a>
      ))}
    </nav>

    <div class="nav-divider" aria-hidden="true"></div>

    <div class="nav-actions">
      <button id="lang-toggle" class="lang-toggle" type="button" aria-label="Cambiar idioma / Switch language">
        <span class="lang-pill" data-lang-es>ES</span>
        <span class="lang-pill" data-lang-en>EN</span>
      </button>
      
      <button id="quick-copy-email" class="btn btn-primary nav-cta" type="button" title="Copiar correo / Copy email">
        <span><T es="Contacto" en="Contact" /></span>
      </button>

      <button
        id="mobile-menu-toggle"
        class="mobile-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="hamburger-line top"></span>
        <span class="hamburger-line bottom"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Overlay -->
  <div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
    <nav class="mobile-nav-links" aria-label="Menú móvil">
      {nav.map((item) => (
        <a href={`#${item.id}`} class="mobile-nav-link font-mono">
          <T es={item.label.es} en={item.label.en} />
        </a>
      ))}
      <a class="btn btn-primary mobile-cta" href={`mailto:${profile.email}`}>
        <T es="Contacto directo" en="Get in touch" />
      </a>
    </nav>
  </div>
</header>

<script is:inline define:vars={{ userEmail: profile.email }}>
  (function () {
    /* 1. Lang Switcher */
    const langBtn = document.getElementById("lang-toggle");
    if (langBtn) {
      langBtn.addEventListener("click", function () {
        const root = document.documentElement;
        const next = root.getAttribute("data-lang") === "es" ? "en" : "es";
        root.setAttribute("data-lang", next);
        root.setAttribute("lang", next);
        try { localStorage.setItem("lang", next); } catch (e) {}
        document.dispatchEvent(new Event("langchange"));
      });
    }

    /* 2. Quick Copy Email Toast */
    const copyBtn = document.getElementById("quick-copy-email");
    const toast = document.getElementById("global-toast");
    if (copyBtn && toast) {
      copyBtn.addEventListener("click", function () {
        navigator.clipboard.writeText(userEmail).then(() => {
          toast.classList.add("is-show");
          setTimeout(() => { toast.classList.remove("is-show"); }, 2800);
        }).catch(() => {
          window.location.href = "mailto:" + userEmail;
        });
      });
    }

    /* 3. Mobile Menu */
    const toggle = document.getElementById("mobile-menu-toggle");
    const drawer = document.getElementById("mobile-drawer");
    let isOpen = false;

    function openMenu() {
      isOpen = true;
      toggle.setAttribute("aria-expanded", "true");
      drawer.setAttribute("aria-hidden", "false");
      drawer.classList.add("is-open");
      toggle.classList.add("is-active");
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      isOpen = false;
      toggle.setAttribute("aria-expanded", "false");
      drawer.setAttribute("aria-hidden", "true");
      drawer.classList.remove("is-open");
      toggle.classList.remove("is-active");
      document.body.style.overflow = "";
    }

    if (toggle && drawer) {
      toggle.addEventListener("click", () => { isOpen ? closeMenu() : openMenu(); });
      drawer.querySelectorAll("a").forEach((l) => l.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && isOpen) closeMenu(); });
    }

    /* 4. Active Section Tracker */
    const navItems = document.querySelectorAll("[data-nav-item]");
    const sectionIds = Array.from(navItems).map((el) => el.getAttribute("data-nav-item"));
    const sections = sectionIds.map((id) => document.getElementById(id)).filter(Boolean);

    if (sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              const activeId = e.target.id;
              navItems.forEach((item) => {
                const isMatch = item.getAttribute("data-nav-item") === activeId;
                item.classList.toggle("is-active", isMatch);
              });
            }
          });
        },
        { threshold: 0.3 }
      );
      sections.forEach((s) => observer.observe(s));
    }
  })();
</script>

<style>
  .nav-dock-container {
    position: fixed;
    top: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    width: min(1140px, 92vw);
    z-index: 50;
  }

  .nav-dock {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding-inline: var(--space-4);
    gap: var(--space-3);
    background: var(--bg-glass);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md), var(--shadow-neon);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-logo {
    height: 26px;
    width: auto;
    display: block;
    filter: drop-shadow(0 0 6px rgba(var(--page-glow), 0.5));
  }

  .brand-name {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .nav-divider {
    width: 1px;
    height: 18px;
    background: var(--border-subtle);
    display: none;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 0.2rem;
  }

  .nav-link {
    color: var(--text-muted);
    font-size: var(--text-xs);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-full);
    transition: color var(--dur-fast) ease, background var(--dur-fast) ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-link.is-active {
    color: #ffffff;
    background: var(--accent);
    font-weight: 500;
    box-shadow: 0 0 12px rgba(var(--page-glow), 0.5);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 32px;
    padding-inline: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--bg-surface-recessed);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .lang-toggle:hover {
    color: var(--accent-2);
    border-color: var(--border-medium);
  }

  .nav-cta {
    display: none;
    padding: 0.35rem 0.9rem;
    font-size: var(--text-xs);
    min-height: 32px;
    border-radius: var(--radius-full);
  }

  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 34px;
    height: 34px;
    padding: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-primary);
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--dur-fast) ease;
  }

  .mobile-toggle.is-active .top { transform: translateY(3px) rotate(45deg); }
  .mobile-toggle.is-active .bottom { transform: translateY(-3px) rotate(-45deg); }

  .mobile-drawer {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 0.5rem;
    background: var(--bg-surface-base);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: var(--shadow-lg);
  }

  .mobile-drawer.is-open {
    display: block;
    animation: drawer-in var(--dur-fast) var(--ease-spring);
  }

  @keyframes drawer-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mobile-nav-links { display: flex; flex-direction: column; gap: var(--space-2); }
  .mobile-nav-link { display: block; padding: 0.55rem 0.8rem; color: var(--text-secondary); font-size: var(--text-sm); border-radius: var(--radius-md); }
  .mobile-nav-link:hover { color: var(--text-primary); background: rgba(255, 255, 255, 0.05); }
  .mobile-cta { margin-top: var(--space-2); width: 100%; }

  @media (min-width: 900px) {
    .nav-divider { display: block; }
    .nav-links { display: flex; }
    .nav-cta { display: inline-flex; }
    .mobile-toggle { display: none; }
    .mobile-drawer { display: none !important; }
  }
</style>

---
import { nav } from "../data/ui";
import { profile } from "../data/content";
import T from "./T.astro";
const base = import.meta.env.BASE_URL;
---

<header class="nav" id="main-nav">
  <div class="nav-inner">
    <a class="brand" href="#home" aria-label={profile.shortName}>
      <img class="brand-logo" src={`${base}images/logo-mark.png`} alt="" width="32" height="33" />
      <span class="brand-name">{profile.shortName}</span>
    </a>

    <!-- Navegación escritorio -->
    <nav class="nav-links" aria-label="Navegación principal">
      {nav.map((item) => (
        <a href={`#${item.id}`} class="nav-link font-mono" data-nav-item={item.id}>
          <T es={item.label.es} en={item.label.en} />
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <button id="lang-toggle" class="lang-toggle" type="button" aria-label="Cambiar idioma / Switch language">
        <span class="lang-pill" data-lang-es>ES</span>
        <span class="lang-pill" data-lang-en>EN</span>
      </button>
      <a class="btn btn-ghost nav-cta" href={`mailto:${profile.email}`}>
        <T es="Contacto" en="Contact" />
      </a>

      <!-- Botón menú móvil -->
      <button
        id="mobile-menu-toggle"
        class="mobile-toggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="hamburger-line top"></span>
        <span class="hamburger-line bottom"></span>
      </button>
    </div>
  </div>

  <!-- Drawer móvil -->
  <div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
    <nav class="mobile-nav-links" aria-label="Menú móvil">
      {nav.map((item) => (
        <a href={`#${item.id}`} class="mobile-nav-link font-mono">
          <T es={item.label.es} en={item.label.en} />
        </a>
      ))}
      <a class="btn btn-primary mobile-cta" href={`mailto:${profile.email}`}>
        <T es="Contacto directo" en="Get in touch" />
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    /* 1. Selector de idioma */
    const langBtn = document.getElementById("lang-toggle");
    if (langBtn) {
      langBtn.addEventListener("click", function () {
        const root = document.documentElement;
        const next = root.getAttribute("data-lang") === "es" ? "en" : "es";
        root.setAttribute("data-lang", next);
        root.setAttribute("lang", next);
        try { localStorage.setItem("lang", next); } catch (e) {}
        document.dispatchEvent(new Event("langchange"));
      });
    }

    /* 2. Menú móvil (A11y, bloqueo de scroll y ESC) */
    const toggle = document.getElementById("mobile-menu-toggle");
    const drawer = document.getElementById("mobile-drawer");
    const mobileLinks = drawer ? drawer.querySelectorAll(".mobile-nav-link, .mobile-cta") : [];
    let isOpen = false;

    function openMenu() {
      isOpen = true;
      toggle.setAttribute("aria-expanded", "true");
      drawer.setAttribute("aria-hidden", "false");
      drawer.classList.add("is-open");
      toggle.classList.add("is-active");
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      isOpen = false;
      toggle.setAttribute("aria-expanded", "false");
      drawer.setAttribute("aria-hidden", "true");
      drawer.classList.remove("is-open");
      toggle.classList.remove("is-active");
      document.body.style.overflow = "";
    }

    if (toggle && drawer) {
      toggle.addEventListener("click", function () {
        if (isOpen) closeMenu();
        else openMenu();
      });

      mobileLinks.forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && isOpen) closeMenu();
      });
    }

    /* 3. Indicador de Sección Activa (IntersectionObserver) */
    const navItems = document.querySelectorAll("[data-nav-item]");
    const sectionIds = Array.from(navItems).map((el) => el.getAttribute("data-nav-item"));
    const sections = sectionIds.map((id) => document.getElementById(id)).filter(Boolean);

    if (sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              const activeId = e.target.id;
              navItems.forEach((item) => {
                const isMatch = item.getAttribute("data-nav-item") === activeId;
                item.classList.toggle("is-active", isMatch);
              });
            }
          });
        },
        { threshold: 0.3 }
      );
      sections.forEach((s) => observer.observe(s));
    }
  })();
</script>

<style>
  .nav {
    position: fixed;
    top: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    width: min(1180px, 92vw);
    z-index: 50;
    background: rgba(12, 14, 23, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    transition: border-color var(--dur-base) ease, background var(--dur-base) ease;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding-inline: var(--space-4);
    gap: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 500;
  }

  .brand-logo {
    height: 30px;
    width: auto;
    display: block;
    filter: drop-shadow(0 0 6px rgba(var(--page-glow), 0.25));
    transition: transform var(--dur-fast) ease;
  }

  .brand:hover .brand-logo {
    transform: scale(1.05);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .nav-links {
    display: none;
    gap: 0.25rem;
  }

  .nav-link {
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-sm);
    transition: color var(--dur-fast) ease, background var(--dur-fast) ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-link.is-active {
    color: var(--accent-2);
    background: rgba(var(--page-glow), 0.1);
    font-weight: 500;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 34px;
    padding-inline: 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--bg-surface-recessed);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .lang-toggle:hover {
    color: var(--accent-2);
    border-color: var(--border-medium);
  }

  .nav-cta {
    display: none;
    padding: 0.4rem 0.9rem;
    font-size: var(--text-xs);
    min-height: 34px;
  }

  /* Hamburguesa móvil */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-primary);
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--dur-fast) ease;
  }

  .mobile-toggle.is-active .top {
    transform: translateY(3.5px) rotate(45deg);
  }
  .mobile-toggle.is-active .bottom {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Drawer móvil */
  .mobile-drawer {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 0.5rem;
    background: var(--bg-surface-base);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    box-shadow: var(--shadow-lg);
  }

  .mobile-drawer.is-open {
    display: block;
    animation: drawer-in var(--dur-fast) var(--ease-editorial);
  }

  @keyframes drawer-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-nav-link {
    display: block;
    padding: 0.6rem 0.8rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
  }

  .mobile-nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .mobile-cta {
    margin-top: var(--space-2);
    width: 100%;
  }

  @media (min-width: 900px) {
    .nav-links { display: flex; }
    .nav-cta { display: inline-flex; }
    .mobile-toggle { display: none; }
    .mobile-drawer { display: none !important; }
  }
</style>
